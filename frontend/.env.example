# GovVote frontend: mẫu biến môi trường. Sao chép thành .env.local (đã nằm trong .gitignore).
#
# CẢNH BÁO: mọi biến bắt đầu bằng VITE_ được Vite nhúng thẳng vào JavaScript gửi tới trình duyệt,
# ai mở trang cũng đọc được. TUYỆT ĐỐI không đặt private key, mnemonic hay RPC credential bí mật ở đây.

# RPC dùng để đọc dữ liệu (Anvil local ở Phase 3).
VITE_RPC_URL=http://127.0.0.1:8545
# Phase 3 chỉ hỗ trợ Anvil (31337). Giá trị khác sẽ bị trang báo lỗi cấu hình.
VITE_CHAIN_ID=31337
# Địa chỉ lấy từ log của script/Deploy.s.sol (xem docs/phase3-frontend-report.md, mục "Chuẩn bị chain").
VITE_GOV_VOTE=
VITE_GOV_TOKEN=

# Tùy chọn: tối đa hai RPC cùng chain/deployment, cách nhau bằng dấu phẩy. Để trống nếu chưa có.
VITE_RPC_FALLBACK_URLS=
