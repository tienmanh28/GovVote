# GovVote: mẫu biến môi trường cho script/Deploy.s.sol và script/SeedDemo.s.sol.
# Sao chép thành .env (đã nằm trong .gitignore) rồi điền giá trị.
# KHÔNG đặt private key, mnemonic hay RPC credential bí mật vào file này hoặc .env.
# Local: ký bằng --unlocked --sender <địa chỉ Anvil>. Testnet: dùng `cast wallet import ... --interactive`.

# ---------- Deploy.s.sol ----------
# (Bắt buộc) Địa chỉ nhận toàn bộ 1.000.000 GOV. Không suy ra từ msg.sender.
TOKEN_RECIPIENT=
# Ngưỡng tạo proposal, đơn vị GOV nguyên (script tự nhân 10^18). Mặc định 1000.
PROPOSAL_THRESHOLD_GOV=1000
# Quorum theo basis point, 1..10000. 1000 = 10%.
QUORUM_BPS=1000
# Số block từ lúc tạo proposal tới snapshot.
VOTING_DELAY_BLOCKS=15
# Số block nhận phiếu sau snapshot (~1 ngày nếu 12 giây/block, chỉ là ước tính).
VOTING_PERIOD_BLOCKS=7200

# ---------- SeedDemo.s.sol (chỉ chain 31337 hoặc 11155111) ----------
# Địa chỉ GovToken lấy từ log của Deploy.s.sol.
GOV_TOKEN=
# 4 ví demo khác nhau, khác ví gửi. Nhận lần lượt 400.000 / 250.000 / 200.000 / 150.000 GOV.
DEMO_ALICE=
DEMO_BOB=
DEMO_CHARLIE=
DEMO_DAVID=
